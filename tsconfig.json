{
	"compilerOptions": {
		"target": "es2024",
		"module": "es2022",
		"moduleResolution": "bundler",
		"lib": ["es2024"],
		"types": ["@cloudflare/workers-types"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules"]
}
